ENTORNO=pruebas
CLIENTE_ID=emred-pruebas
CONECTOR_SECRETO=
# Acceso al formulario admin/clonar_cupon_generico.php. Si falta alguno, no
# entra nadie.
# - SECRETO: firma la cookie de sesión; nadie lo teclea. Distinto de
#   CONECTOR_SECRETO. Generar con: openssl rand -hex 32
# - PASSWORD_HASH: el password_hash de la contraseña, nunca la contraseña.
#   Entre comillas simples, porque lleva «$».
CUPONES_GENERICOS_SECRETO=
CUPONES_GENERICOS_USUARIO=
CUPONES_GENERICOS_PASSWORD_HASH=''
ADMITIR_KEY_QUERYSTRING=false
CONFIAR_EN_PROXY=true
ORIGENES_CORS_PERMITIDOS=https://shopify.emred.com
METODOS_CORS_PERMITIDOS=POST,OPTIONS
LOG_NIVEL=info
LOG_FORMATO=texto
LOG_ENMASCARAR_EMAILS=true
SALESMANAGO_API_BASE=https://app2.manago.ai
SALESMANAGO_CLIENT_ID=
SALESMANAGO_API_KEY=
SALESMANAGO_SHA=
SALESMANAGO_OWNER=marketing@emred.com
VOUCHERIFY_API=https://api.voucherify.io
VOUCHERIFY_APP_ID=
VOUCHERIFY_SECRET_KEY=
SHOPIFY_STORE=
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=2026-07
